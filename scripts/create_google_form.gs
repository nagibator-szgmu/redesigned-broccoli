/**
 * Google Apps Script для автоматического создания опросника MedSim в Google Формах.
 * 
 * ИНСТРУКЦИЯ (30 секунд):
 * 1. Зайди на сайт: https://script.google.com
 * 2. Нажми «Новый проект» (кнопка слева вверху).
 * 3. Удали всё что там написано и вставь весь этот код.
 * 4. Нажми кнопку «Выполнить» (Run / синяя кнопка со стрелкой сверху).
 * 5. Разреши доступ (Google спросит разрешение создать форму на твоем Google Диске).
 * 6. Внизу в консоли (Журнал выполнения) появятся две ссылки:
 *    - Ссылка для редактирования (откроется твоя форма, где ты сможешь всё подправить!)
 *    - Ссылка для студентов (голосование)
 */

function createMedSimSurvey() {
  var form = FormApp.create('Тестирование MedSim (Гастроэнтерология, 6 курс)');
  
  form.setDescription(
    'Ребята, привет! Мы разрабатываем MedSim — клинический тренажер для отработки дежурств и тактики врача. ' +
    'Вы только что прошли гастроэнтерологический кейс. Нам важно сделать продукт, который не стыдно открыть ' +
    'перед аккредитацией или реальным приёмом. Опрос анонимный, 3–4 минуты, чисто про визуал и новые фичи.'
  );

  // -------------------------------------------------------------
  // РАЗДЕЛ 1: Визуал и первое впечатление
  // -------------------------------------------------------------
  var page1 = form.addPageBreakItem();
  page1.setTitle('Раздел 1. Визуал и первое впечатление');

  var q1 = form.addScaleItem();
  q1.setTitle('1. Как тебе общий визуальный стиль рабочей станции врача?')
    .setBounds(1, 5)
    .setLabels('Выглядит как тест из нулевых', 'Стильно, современно, приятно')
    .setRequired(true);

  var q2 = form.addCheckboxItem();
  q2.setTitle('2. Что по восприятию информации на экране?')
    .setChoiceValues([
      'Слишком много мелкого текста, глаза устают',
      'Монитор витальных показателей (пульс, АД, сатурация) читается отлично',
      'Не сразу понял(а), куда нажимать в первые 10 секунд',
      'Панели и вкладки перегружены лишними кнопками',
      'Всё структурировано и понятно с первого взгляда'
    ])
    .setRequired(true);

  var q3 = form.addParagraphTextItem();
  q3.setTitle('3. Что в интерфейсе показалось самым неудобным или «топорным»?')
    .setHelpText('Где застрял, какую кнопку долго искал, что выглядит криво на экране? Если всё ок — оставь пустым')
    .setRequired(false);

  // -------------------------------------------------------------
  // РАЗДЕЛ 2: Клиника: Гастроэнтерология и неотложка
  // -------------------------------------------------------------
  var page2 = form.addPageBreakItem();
  page2.setTitle('Раздел 2. Клиника: Гастроэнтерология и неотложка');

  var q4 = form.addMultipleChoiceItem();
  q4.setTitle('4. Насколько кейс похож на реального пациента в приёмнике / отделении?')
    .setChoiceValues([
      'Реалистично: клиническая картина, динамика и назначения соответствуют практике',
      'Условно: пациент похож, но варианты действий в симуляторе ограничены',
      'Оторвано от жизни: на кафедре / дежурстве нас учат вести таких больных иначе'
    ])
    .setRequired(true);

  var q5 = form.addCheckboxItem();
  q5.setTitle('5. Хватило ли тебе диагностических и лечебных опций по гастроэнтерологии?')
    .setChoiceValues([
      'Не хватило специфических анализов (коагулограмма, амилаза/липаза, билирубин по фракциям)',
      'Не хватило инструменталки (УЗИ ОБП, срочная ФГДС, КТ брюшной полости с контрастом)',
      'Не хватило правильных дозировок или схем (болюсы ИПП, октреотид, гемостатики, инфузионная терапия)',
      'Всё базовое для неотложки есть'
    ])
    .setRequired(true);

  var q6 = form.addParagraphTextItem();
  q6.setTitle('6. Какая медицинская нестыковка бросилась в глаза?')
    .setHelpText('«Не согласен с оценкой за...», «При ЖКК нельзя было медлить с...» и т.д.')
    .setRequired(false);

  // -------------------------------------------------------------
  // РАЗДЕЛ 3: Битва новых фичей: Что добавить в первую очередь?
  // -------------------------------------------------------------
  var page3 = form.addPageBreakItem();
  page3.setTitle('Раздел 3. Битва новых фичей: Что добавить в первую очередь?');

  var q7 = form.addCheckboxItem();
  q7.setTitle('7. Выбери ТОП-3 фичи, ради которых ты бы сам(а) регулярно тренировался в симуляторе:')
    .setChoiceValues([
      'Реальный визуал: настоящие фото/видео эндоскопии (язвы по Forrest, варикозные вены), сканы КТ/рентгена и пленки ЭКГ вместо текста',
      'Живой опрос больного (ИИ-чат): возможность опрашивать пациента голосом или свободным текстом, а не тыкать заготовленные вопросы',
      'Клинические шкалы внутри кейса: калькуляторы прямо во время игры (Rockall, Glasgow-Blatchford при ЖКК, Child-Pugh / MELD, критерии панкреатита)',
      'Режим подготовки к Аккредитации (ПАС / ОСКЭ): отработка конкретных станций по официальным паспортам станций с таймером',
      'Нативное мобильное приложение: чтобы решать кейсы с телефона в метро или между парами',
      'Дуэли и мультиплеер: одновременное решение кейса на скорость/точность с одногруппниками или рейтинг курса',
      'Генерация готового дневника курации / истории болезни: выгрузка аккуратного протокола осмотра по итогам твоих действий'
    ])
    .setRequired(true);

  var q8 = form.addParagraphTextItem();
  q8.setTitle('8. Если бы у тебя была возможность придумать ЛЮБУЮ фичу, которой нет ни в одном медицинском приложении — что бы это было?')
    .setHelpText('Самая смелая идея — от озвучки стонов пациента до разбора с преподавателем кафедры')
    .setRequired(false);

  // -------------------------------------------------------------
  // РАЗДЕЛ 4: Финал
  // -------------------------------------------------------------
  var page4 = form.addPageBreakItem();
  page4.setTitle('Раздел 4. Финал');

  var q9 = form.addScaleItem();
  q9.setTitle('9. Общая оценка симулятора:')
    .setBounds(1, 5)
    .setLabels('Слабо / не готово', 'Отлично, крутой проект')
    .setRequired(true);

  var q10 = form.addTextItem();
  q10.setTitle('10. Одно главное слово/предложение создателям:')
    .setHelpText('Хейт, совет, пожелание или поддержка — пиши как есть')
    .setRequired(false);

  // Попытка настроить открытый доступ без авторизации
  try {
    form.setRequireLogin(false);
  } catch (e) {}
  try {
    form.setCollectEmail(false);
  } catch (e) {}

  Logger.log('==================================================');
  Logger.log('УСПЕХ! Форма создана.');
  Logger.log('ССЫЛКА ДЛЯ РЕДАКТИРОВАНИЯ (подправить руками):');
  Logger.log(form.getEditUrl());
  Logger.log('ССЫЛКА ДЛЯ СТУДЕНТОВ (для прохождения):');
  Logger.log(form.getPublishedUrl());
  Logger.log('==================================================');
}
