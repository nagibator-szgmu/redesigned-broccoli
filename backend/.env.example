# Окружение приложения (development | staging | production)
APP_ENV=development

# Хост и порт сервера
HOST=0.0.0.0
PORT=8000

# URL базы данных (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/medsim

# Секретный ключ для JWT — для будущих этапов
# JWT_SECRET=change-me-in-production

# Время жизни access-токена в минутах — для будущих этапов
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: разрешённые origins через запятую — для будущих этапов
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
