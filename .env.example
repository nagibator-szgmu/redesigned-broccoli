# MedSim Environment Variables Template
# Скопируйте этот файл в .env.local для локальной разработки: cp .env.example .env.local

# Базовый URL API бэкенда (если используется FastAPI)
VITE_API_BASE=http://localhost:8000/api/v1

# Режим разработчика (true открывает все кейсы, скрывает блокировки прогресса)
VITE_DEV_MODE=true

# Ключи для ИИ-пациента и разбора ошибок (опционально для локальных тестов)
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=
